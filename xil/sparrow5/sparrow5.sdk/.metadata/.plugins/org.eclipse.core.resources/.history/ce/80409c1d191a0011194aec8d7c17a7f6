void SSD1315_Clear(void) {
    // Устанавливаем диапазон столбцов на весь буфер (0 - 127)
    SSD1315_WriteCommand(0x21);
    SSD1315_WriteCommand(0);
    SSD1315_WriteCommand(127); // 127 (0x7F) — это максимальная ширина буфера SSD1315

    // Устанавливаем диапазон страниц на весь буфер (0 - 7)
    SSD1315_WriteCommand(0x22);
    SSD1315_WriteCommand(0);
    SSD1315_WriteCommand(7);  // 7 (0x07) — это 8 страниц по 8 пикселей (64 пикселя высотой)

    u8 zero = 0x00;

    // Чистим 128 * 8 = 1024 байта (весь RAM контроллера)
    for(int i = 0; i < 1024; i++) {
        SSD1315_WriteData(&zero, 1);
    }
}
// ==========================================
// ФУНКЦИИ ТЕКСТА
// ==========================================
// ==========================================
// НАСТРОЙКИ СМЕЩЕНИЯ
// ==========================================
// Для экрана 72x40 данные часто начинаются с 28-го столбца RAM
#define OLED_OFFSET_X 28
// Если текст все еще не влезает или уехал влево, меняйте это число (0, 10, 20, 28, 32...)

// ==========================================
// ИСПРАВЛЕННАЯ ФУНКЦИЯ ВЫВОДА СИМВОЛА
// ==========================================
void SSD1315_WriteChar(char ch, int x, int y) {
    // 1. Добавляем смещение, чтобы попасть в видимую зону
    x += OLED_OFFSET_X;

    // Проверка границ (с учетом смещения)
    // Мы не можем рисовать правее 127 столбца
    if (x >= 128 || y >= (SSD1315_HEIGHT/8)) return;

    // Получаем индекс символа
    if (ch < 0x20 || ch > 0x7F) ch = 0x20;
    int char_index = (ch - 0x20) * FONT_WIDTH;

    // Устанавливаем курсор
    SSD1315_SetCursor(x, y);

    // 2. Используем static буфер (ИСПРАВЛЕНИЕ МУСОРА/ПОЛОС)
    // Это гарантирует, что данные будут видны контроллеру I2C
    static u8 buffer[FONT_WIDTH + 1];

    buffer[0] = 0x40; // Control byte

    for (int i = 0; i < FONT_WIDTH; i++) {
        buffer[i+1] = font6x8[char_index + i];
    }

    // Отправка
    XIicPs_MasterSendPolled(&Iic, buffer, FONT_WIDTH + 1, SSD1315_ADDR);
    I2C_WaitBusy();
}
