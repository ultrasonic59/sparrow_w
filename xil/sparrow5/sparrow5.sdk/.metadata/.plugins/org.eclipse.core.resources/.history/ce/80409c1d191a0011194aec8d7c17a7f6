void SSD1315_SetCursor(u8 col, u8 page) {
    SSD1315_WriteCommand(0xB0 | page);       // Установка страницы (Y)
    SSD1315_WriteCommand(col & 0x0F);        // Нижние биты колонки (X Low)
    SSD1315_WriteCommand(0x10 | (col >> 4)); // Верхние биты колонки (X High)
}
