void SSD1315_Init(void) {
    SSD1315_WriteCommand(0xAE); // Display OFF
    SSD1315_WriteCommand(0xD5); // Set Display Clock Divide
    SSD1315_WriteCommand(0x80); // Recommended Ratio
    SSD1315_WriteCommand(0xA8); // Set Multiplex Ratio
    SSD1315_WriteCommand(0x27); // 39 для высоты 40
    SSD1315_WriteCommand(0xD3); // Set Display Offset
    SSD1315_WriteCommand(0x00); // No offset
    SSD1315_WriteCommand(0x40); // Set Display Start Line (Line 0)

    // ! ВАЖНО: Page Addressing Mode (0x02)
    SSD1315_WriteCommand(0x20);
    SSD1315_WriteCommand(0x02); // 0x02 = Page Addressing Mode

    SSD1315_WriteCommand(0xA1); // Segment Remap
    SSD1315_WriteCommand(0xC8); // COM Output Scan Direction
    SSD1315_WriteCommand(0xDA); // Set COM Pins
    SSD1315_WriteCommand(0x02); // Для 40px дисплеев
    SSD1315_WriteCommand(0x81); // Set Contrast
    SSD1315_WriteCommand(0x7F);
    SSD1315_WriteCommand(0xD9); // Set Pre-charge
    SSD1315_WriteCommand(0xF1);
    SSD1315_WriteCommand(0xDB); // Set VCOMH
    SSD1315_WriteCommand(0x40);
    SSD1315_WriteCommand(0xA4); // Resume Display
    SSD1315_WriteCommand(0xA6); // Normal
    SSD1315_WriteCommand(0xAF); // Display ON
}
