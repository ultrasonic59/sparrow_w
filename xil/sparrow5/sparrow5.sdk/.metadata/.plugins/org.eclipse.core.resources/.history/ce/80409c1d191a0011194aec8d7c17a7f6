// Вывод строки
void SSD1315_DrawString(char *str, int x, int y) {
    int cursor_x = x;
    int cursor_y = y;

    while (*str) {
        // Обработка переноса строки
        if (*str == '\n') {
            cursor_y++;
            cursor_x = x;
            str++; // Переход к след символу ТОЛЬКО при обработке \n
            continue;
        }

        // Перенос если вышли за ширину
        if (cursor_x + FONT_WIDTH > 128) {
            cursor_y++;
            cursor_x = x;
        }

        // Если вышли за высоту - стоп
        if (cursor_y >= 8) break;

        // Рисуем СЕЙЧАСШНИЙ символ
        SSD1315_WriteChar(*str, cursor_x, cursor_y);

        // Сдвигаем курсор
        cursor_x += FONT_WIDTH;

        // Переходим к СЛЕДУЮЩЕМУ символу (ИСПРАВЛЕНИЕ)
        str++;
    }
}
