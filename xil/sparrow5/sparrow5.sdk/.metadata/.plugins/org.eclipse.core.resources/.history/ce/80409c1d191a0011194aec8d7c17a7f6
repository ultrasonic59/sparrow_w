// ==========================================
// НИЗКОУРОВНЕВЫЕ ФУНКЦИИ I2C & SSD1315
// ==========================================
void I2C_WaitBusy(void) {
    while (XIicPs_BusIsBusy(&Iic));
}

void SSD1315_WriteCommand(u8 cmd) {
    u8 buf[2] = {0x00, cmd};
    XIicPs_MasterSendPolled(&Iic, buf, 2, SSD1315_ADDR);
    I2C_WaitBusy();
}

void SSD1315_WriteData(u8 *data, int len) {
    u8 buf[2];
    buf[0] = 0x40;

    // Отправляем данные по 1 байту для надежности (медленно, но просто)
    for (int i = 0; i < len; i++) {
        buf[1] = data[i];
        XIicPs_MasterSendPolled(&Iic, buf, 2, SSD1315_ADDR);
        I2C_WaitBusy();
    }
}
