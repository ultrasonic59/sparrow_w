#include "xparameters.h"
#include "xil_printf.h"
#include "xiicps.h"
#include "sleep.h"

#define I2C_DEVICE_ID XPAR_XIICPS_0_DEVICE_ID // Попробуйте поменять на 1, если 0 не дает результатов

int main(void) {
    XIicPs Iic;
    XIicPs_Config *IicConfig;
    int Status;
    u8 Buffer[1]; // Буфер фиктивный, нам важен только адрес
    int found_devices = 0;

    xil_printf("\r\n--- I2C Scanner Start ---\r\n");

    // Стандартная инициализация
    IicConfig = XIicPs_LookupConfig(I2C_DEVICE_ID);
    if (NULL == IicConfig) {
        xil_printf("Config Lookup failed\r\n");
        return XST_FAILURE;
    }

    Status = XIicPs_CfgInitialize(&Iic, IicConfig, IicConfig->BaseAddress);
    if (Status != XST_SUCCESS) {
        xil_printf("CfgInit failed\r\n");
        return XST_FAILURE;
    }

    XIicPs_SetSClk(&Iic, 100000); // 100 kHz

    // Цикл по всем возможным 7-битным адресам (от 0x03 до 0x77)
    for (int addr = 0x03; addr < 0x78; addr++) {

        // Пытаемся отправить 0 байт данных (только адрес)
        // Если MCP4725 на линии, он ответит ACK
        Status = XIicPs_MasterSendPolled(&Iic, Buffer, 0, (u8)addr);

        if (Status == XST_SUCCESS) {
            xil_printf("Device found at address: 0x%02X\r\n", addr);
            found_devices++;
        }

        // Небольшая пауза, чтобы не спамить шину слишком быстро
        usleep(1000);
    }

    if (found_devices == 0) {
        xil_printf("No I2C devices found.\r\n");
        xil_printf("Check:\r\n");
        xil_printf("1. GND connection\r\n");
        xil_printf("2. Pull-up resistors on SDA/SCL\r\n");
        xil_printf("3. Correct I2C pins (MIO)\r\n");
    } else {
        xil_printf("Scan complete. Found %d devices.\r\n", found_devices);
    }

    while(1); // Стоп
    return 0;
}
