# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y4 [get_cells pll1/inst/clkf_buf]
set_property LOC BUFGCTRL_X0Y0 [get_cells pll1/inst/clkout3_buf]
set_property LOC BUFGCTRL_X0Y3 [get_cells pll1/inst/clkout2_buf]
set_property LOC BUFGCTRL_X0Y16 [get_cells i_ps/system_i/sparrow_ps_i/processing_system7_0/inst/buffer_fclk_clk_0.FCLK_CLK_0_BUFG]
set_property LOC BUFGCTRL_X0Y2 [get_cells i_ps/CLK_BUFG_inst]
set_property LOC BUFGCTRL_X0Y1 [get_cells dbg_hub/inst/BSCANID.u_xsdbm_id/SWITCH_N_EXT_BSCAN.u_bufg_icon_tck]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X0Y4 [get_cells u_dac_/dac_dclk_obuf]
set_property LOC IOB_X0Y28 [get_cells u_dac_/dac_clk_obuf]

# Location of clock ports
set_property LOC IOB_X0Y95 [get_ports i_clk24]

# Clock net "pll1/inst/clk_out3" driven by instance "pll1/inst/clkout3_buf" located at site "BUFGCTRL_X0Y0"
#startgroup
create_pblock {CLKAG_pll1/inst/clk_out3}
