#include "xparameters.h"
#include "xil_printf.h"
#include "xiicps.h"
#include "sleep.h"

// ==========================================
// НАСТРОЙКИ
// ==========================================

// Укажите тот ID, который сработал в I2C Scanner (обычно 0 или 1)
#define I2C_DEVICE_ID    XPAR_XIICPS_0_DEVICE_ID

// Адрес SSD1315 (обычно 0x3C, иногда 0x3D)
#define SSD1315_ADDR     0x3C

// Размеры экрана
#define SSD1315_WIDTH    72
#define SSD1315_HEIGHT   40

// ==========================================
// ГЛОБАЛЬНЫЕ ПЕРЕМЕННЫЕ
// ==========================================
XIicPs Iic;

// ==========================================
// ФУНКЦИИ НИЗКОГО УРОВНЯ
// ==========================================

// Ожидание завершения передачи на шине (защита от зависаний)
void I2C_WaitBusy(void) {
    while (XIicPs_BusIsBusy(&Iic)) {
        /* Wait */
    }
}

// Отправка команды в дисплей
// Команда посылается с префиксом 0x00
void SSD1315_WriteCommand(u8 cmd) {
    u8 buf[2] = {0x00, cmd}; // 0x00 означает Co=0, D/C#=0 (Command)
    XIicPs_MasterSendPolled(&Iic, buf, 2, SSD1315_ADDR);
    I2C_WaitBusy();
}

// Отправка данных (пикселей) в дисплей
// Данные посылаются с префиксом 0x40
// Чтобы ускорить, мы можем отправлять пачку байт, но сначала нужно отправить 0x40
void SSD1315_WriteData(u8 *data, int len) {
    // Формируем буфер: первый байт 0x40, затем данные
    // Внимание: буфер должен быть достаточно большим!
    // Для простоты примера будем слать по 1 байту данных (медленно, но надежно для теста)
    // Для оптимизации лучше использовать DMA или больший буфер.

    u8 buf[2];
    buf[0] = 0x40; // Control byte for Data stream

    for (int i = 0; i < len; i++) {
        buf[1] = data[i];
        XIicPs_MasterSendPolled(&Iic, buf, 2, SSD1315_ADDR);
        I2C_WaitBusy();
    }
}

// ==========================================
// ИНИЦИАЛИЗАЦИЯ ДИСПЛЕЯ
// ==========================================
void SSD1315_Init(void) {
    xil_printf("Initializing SSD1315...\r\n");

    // Soft Reset
    SSD1315_WriteCommand(0xAE); // Display OFF
    SSD1315_WriteCommand(0xD5); // Set Display Clock Divide
    SSD1315_WriteCommand(0x80); // Recommended Ratio
    SSD1315_WriteCommand(0xA8); // Set Multiplex Ratio
    SSD1315_WriteCommand(0x27); // 0x27 = 39 (40-1) для высоты 40
    SSD1315_WriteCommand(0xD3); // Set Display Offset
    SSD1315_WriteCommand(0x00); // No offset
    SSD1315_WriteCommand(0x40); // Set Display Start Line (Line 0)

    // Charge Pump
    SSD1315_WriteCommand(0x8D);
    SSD1315_WriteCommand(0x14); // Enable charge pump

    // Memory Addressing Mode
    SSD1315_WriteCommand(0x20);
    SSD1315_WriteCommand(0x00); // Horizontal Addressing Mode

    // Segment Remap и COM Scan Direction
    // Эти настройки зависят от ориентации экрана.
    // Если экран перевернут, поменяйте 0xA1 на 0xA0 и 0xC8 на 0xC0.
    SSD1315_WriteCommand(0xA1); // Segment Remap (Column 127 mapped to SEG0)
    SSD1315_WriteCommand(0xC8); // COM Output Scan Direction (Remapped mode)

    // Компенсация емкостей
    SSD1315_WriteCommand(0xDA);
    SSD1315_WriteCommand(0x02); // For 40px height usually 0x12 is default, but try 0x02

    // Contrast
    SSD1315_WriteCommand(0x81);
    SSD1315_WriteCommand(0x7F); // Half contrast

    // Set Pre-charge Period
    SSD1315_WriteCommand(0xD9);
    SSD1315_WriteCommand(0xF1);

    // Set VCOMH Deselect Level
    SSD1315_WriteCommand(0xDB);
    SSD1315_WriteCommand(0x40);

    SSD1315_WriteCommand(0xA4); // Resume Display (Content follows RAM)
    SSD1315_WriteCommand(0xA6); // Normal Display (not inverted)
    SSD1315_WriteCommand(0xAF); // Display ON

    xil_printf("Init Done.\r\n");
}

// Установка положения курсора (Column, Page)
void SSD1315_SetCursor(u8 col, u8 page) {
    SSD1315_WriteCommand(0xB0 | page); // Set Page Address
    SSD1315_WriteCommand(col & 0x0F);  // Set Lower Column Address
    SSD1315_WriteCommand(0x10 | (col >> 4)); // Set Higher Column Address
}

// Заполнение экрана цветом (0x00 - выкл, 0xFF - вкл)
void SSD1315_Fill(u8 color) {
    // Устанавливаем адресацию в начало
    SSD1315_WriteCommand(0x21); // Column addr
    SSD1315_WriteCommand(0);
    SSD1315_WriteCommand(SSD1315_WIDTH - 1);

    SSD1315_WriteCommand(0x22); // Page addr
    SSD1315_WriteCommand(0);
    SSD1315_WriteCommand((SSD1315_HEIGHT / 8) - 1);

    // Отправляем данные
    int total_pixels = SSD1315_WIDTH * (SSD1315_HEIGHT / 8);
    for (int i = 0; i < total_pixels; i++) {
        u8 data = color;
        SSD1315_WriteData(&data, 1);
    }
}

// Рисование тестового паттерна (шахматная доска)
void SSD1315_TestPattern(void) {
    SSD1315_SetCursor(0, 0);

    SSD1315_WriteCommand(0x21); // Column addr
    SSD1315_WriteCommand(0);
    SSD1315_WriteCommand(SSD1315_WIDTH - 1);

    SSD1315_WriteCommand(0x22); // Page addr
    SSD1315_WriteCommand(0);
    SSD1315_WriteCommand(4); // 5 pages (0..4)

    int total_pixels = SSD1315_WIDTH * 5;
    for (int i = 0; i < total_pixels; i++) {
        u8 data = (i % 2 == 0) ? 0xAA : 0x55;
        SSD1315_WriteData(&data, 1);
    }
}

// ==========================================
// MAIN
// ==========================================
int main(void) {
    XIicPs_Config *IicConfig;
    int Status;

    xil_printf("\r\n--- SSD1315 OLED Test ---\r\n");

    // 1. Инит I2C
    IicConfig = XIicPs_LookupConfig(I2C_DEVICE_ID);
    if (NULL == IicConfig) {
        xil_printf("I2C Lookup Config failed\r\n");
        return XST_FAILURE;
    }

    Status = XIicPs_CfgInitialize(&Iic, IicConfig, IicConfig->BaseAddress);
    if (Status != XST_SUCCESS) {
        xil_printf("I2C Cfg Initialize failed\r\n");
        return XST_FAILURE;
    }

    Status = XIicPs_SetSClk(&Iic, 100000); // 100kHz
    if (Status != XST_SUCCESS) {
        xil_printf("I2C SetSClk failed\r\n");
        return XST_FAILURE;
    }

    // 2. Инит Дисплея
    SSD1315_Init();

    // 3. Цикл тестов
    while (1) {
        xil_printf("Step 1: Clear Screen (Black)\r\n");
        SSD1315_Fill(0x00);
        sleep(2);

        xil_printf("Step 2: Fill Screen (White)\r\n");
        SSD1315_Fill(0xFF);
        sleep(2);

        xil_printf("Step 3: Checkers Pattern\r\n");
        SSD1315_TestPattern();
        sleep(2);
    }

    return 0;
}
